# Copy to frontend/.env.local
# Base URL of the backend API (no trailing slash).
# Local dev: http://localhost:5000   |   Production: your Render service URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Secret key sequence typed on /auth to reveal /auth/admin (defaults to 190436 if unset)
NEXT_PUBLIC_ADMIN_CIPHER=190436

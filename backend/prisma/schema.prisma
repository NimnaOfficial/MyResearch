generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // The 'url' property is removed here for Prisma 7 compatibility
}

model User {
  id           String     @id @default(uuid())
  fullName     String?
  age          String?  
  phone        String?  
  profilePic   String?  
  username     String     @unique
  email        String     @unique
  isVerified   Boolean    @default(false)
  passwordHash String
  createdAt    DateTime   @default(now())
  feedbacks    Feedback[] 
  
  // Explicitly named relations so Prisma knows the difference
  posts        Post[]     @relation("AuthoredPosts") 
  savedPosts   Post[]     @relation("SavedPosts")

  role       String   @default("user")

  status String @default("ACTIVE")

  lastIp        String?
  lastUserAgent String?
  lastLogin     DateTime?
  requestCount  Int       @default(0)
  logs          ActivityLog[]
  lastDevice  String?
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  status    String   // "OK", "WARN", "ERROR"
  ip        String?
  createdAt DateTime @default(now())
}

model Feedback {
  id          String   @id @default(uuid())
  userId      String?  
  rating      Int
  category    String
  priority    String
  tags        String?
  recommend   Boolean
  message     String
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}

model Category {
  id    String @id @default(uuid())
  name  String
  slug  String @unique
  posts Post[]
}

model Post {
  id         String    @id @default(uuid())
  title      String
  slug       String    @unique
  content    String
  type       String    @default("BLOG")
  published  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  
  categoryId String?
  Category   Category? @relation(fields: [categoryId], references: [id])

  // Explicitly matching the named relations from the User model
  authorId   String
  author     User      @relation("AuthoredPosts", fields: [authorId], references: [id])
  savedBy    User[]    @relation("SavedPosts")
}

model Release {
  id           String   @id @default(uuid())
  projectName  String
  version      String
  releaseNotes String
  downloadUrl  String
  publishedAt  DateTime @default(now())
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id    String @id @default(uuid())
  name  String @unique
  slug  String @unique
  posts Post[] 
}

model Post {
  id          String     @id @default(uuid())
  title       String
  slug        String     @unique
  content     String     @db.Text 
  type        PostType   @default(BLOG)
  published   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt 
  
  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  categories  Category[] 
}

model Release {
  id           String   @id @default(uuid())
  projectName  String
  version      String
  releaseNotes String   @db.Text 
  downloadUrl  String
  publishedAt  DateTime @default(now())
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique // <-- 1. Track the email
  isVerified   Boolean  @default(false) // <-- 2. Track verification status
  passwordHash String
  createdAt    DateTime @default(now())
  posts        Post[]   
}

enum PostType {
  BLOG
  RESEARCH
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // The 'url' property is removed here for Prisma 7 compatibility (ensure it's in your .env)
}

// ==========================================
// SYSTEM USERS & IDENTITIES
// ==========================================
model User {
  id            String        @id @default(uuid())
  fullName      String?
  age           String?  
  phone         String?  
  profilePic    String?  
  username      String        @unique
  email         String        @unique
  isVerified    Boolean       @default(false)
  passwordHash  String
  createdAt     DateTime      @default(now())
  
  // Relations
  feedbacks     Feedback[] 
  posts         Post[]        @relation("AuthoredPosts") 
  savedPosts    Post[]        @relation("SavedPosts")
  logs          ActivityLog[]

  role          String        @default("user")
  status        String        @default("ACTIVE")

  // Telemetry
  lastIp        String?
  lastUserAgent String?
  lastDevice    String?
  lastLogin     DateTime?
  requestCount  Int           @default(0)
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  status    String   // "OK", "WARN", "ERROR"
  ip        String?
  createdAt DateTime @default(now())
}

model Feedback {
  id          String   @id @default(uuid())
  userId      String?  
  rating      Int
  category    String
  priority    String
  tags        String?
  recommend   Boolean
  message     String
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}

// ==========================================
// RESEARCH MATRIX (DATA CORES)
// ==========================================
model Category {
  id    String @id @default(uuid())
  name  String
  slug  String @unique
  posts Post[]
}

model Post {
  id           String    @id @default(uuid())
  title        String
  slug         String    @unique
  content      String    // Abstract / Summary 
  type         String    @default("Research")
  published    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  heroImg      String?
  
  // The Master Data Core JSON Payload
  advancedData String?   
  
  categoryId   String?
  Category     Category? @relation(fields: [categoryId], references: [id])

  authorId     String?
  author       User?     @relation("AuthoredPosts", fields: [authorId], references: [id])
  savedBy      User[]    @relation("SavedPosts")
}

// ==========================================
// PROJECT RELEASES (ARCHITECTURE VAULT)
// ==========================================
model Release {
  id           String   @id @default(uuid())
  projectName  String
  version      String
  releaseNotes String
  downloadUrl  String?  // Made optional: Not all projects have downloadable ZIPs
  heroImg      String?
  published    Boolean  @default(false)
  
  // The Master Data Core JSON Payload
  advancedData String?
  
  // Standard Lifecycle Tracking
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

// ==========================================
// SYSTEM QUERIES FORGE (FAQs)
// ==========================================
model Faq {
  id           String   @id @default(uuid())
  query        String
  response     String
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ==========================================
// SHOWCASE MEDIA FORGE
// ==========================================
model Showcase {
  id           String   @id @default(uuid())
  title        String
  videoUrl     String
  thumbnailUrl String?
  description  String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
# Copy to backend/.env and fill in. NEVER commit the real .env file.

# --- 100% Local Setup (Defaults) ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=

# --- Database (100% Local SQLite by default) ---
DATABASE_URL=file:./dev.db

# --- Optional Cloud Turso Database ---
USE_REMOTE_TURSO=false
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Storage (false = Local Disk backend/uploads/ | true = Cloudinary) ---
USE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Auth ---
JWT_SECRET=super_secure_matrix_key_2026

# --- E-mail & Real-Time Telemetry Notifications (HTTPS Port 443 - Cloud Safe) ---
# Choice 1: Google Apps Script Webhook Relay (100% Free, Zero Domain, sends from your Gmail to ANY user)
EMAIL_RELAY_URL=

# Choice 2: Brevo REST API (300 Free Emails/day to ANY recipient, Single Sender Verification, Zero Domain)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=nimnakgls980@gmail.com
BREVO_SENDER_NAME=CSx Matrix

# Choice 3: Resend HTTPS API (Requires custom domain to deliver to third-party recipients)
RESEND_API_KEY=
RESEND_FROM=CSx Matrix <onboarding@resend.dev>

# Optional Instant Mobile Alert (<20ms to your phone)
DISCORD_WEBHOOK_URL=

# --- PDF Engine (true = fast native engine for cloud hosts like Render | false = Puppeteer) ---
USE_NATIVE_PDF=true

# --- Master Admin Seeding (used by npm run seed:admin) ---
ADMIN_EMAIL=nimnakgls980@gmail.com
ADMIN_PASSWORD=Admin@Nima2026!
